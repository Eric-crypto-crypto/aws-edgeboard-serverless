{
  "name": "aws-edgeboard-serverless",

  // Base image: Microsoft's official Python 3.13 dev image (matches the Lambda runtime)
  "image": "mcr.microsoft.com/devcontainers/python:3.13",

  // Features: extra tools installed on top of the base image
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},     // AWS CLI v2
    "ghcr.io/devcontainers/features/terraform:1": {},   // Terraform (latest by default; >= 1.10 required)
    "ghcr.io/devcontainers/features/github-cli:1": {}   // GitHub CLI (must be added explicitly with this image)
  },

    // Script to run after the container is created
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Environment variables: use the edgeboard AWS profile by default
  "remoteEnv": {
    "AWS_PROFILE": "edgeboard"
  },
  
  // VS Code extensions installed automatically
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",   // Terraform syntax highlighting, completion, formatting
        "ms-python.python",       // Python support
        "anthropic.claude-code"  // Claude Code for VS Code
      ]
    }
  }
}
